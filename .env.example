# agent-bridge deployment config — copy to .env and fill in.
# .env is gitignored: everything here is deployment/identity-specific.

# ── Claude Agent SDK ──
# Workspace the owner-role agent runs in (cwd for claude sessions)
BRIDGE_WORK_DIR="~/workspaces/mywork"
# CLAUDE_CONFIG_DIR for the SDK subprocess (account/credential isolation)
BRIDGE_CLAUDE_CONFIG_DIR="~/.claude"
BRIDGE_CLAUDE_BIN="~/.local/bin/claude"

# Bot display name used in /start greetings
BRIDGE_BOT_TITLE="my agent bridge"

# ── Telegram adapter ──
# Either a secret-manager reference resolved by start-telegram.sh at runtime…
OP_TELEGRAM_TOKEN_REF="op://Vault/Item/token"
# …or the raw token (avoid if you have a secret manager):
# TELEGRAM_BOT_TOKEN="123456:ABC..."
# Comma-separated Telegram user ids with full (owner) access
TG_OWNER_USER_IDS="12345678"
# TG_ALLOW_GROUPS=1
# TG_GUEST_DAILY_CAP_USD=2.0
# TG_TASK_TIMEOUT_S=900
# TG_MAX_CONCURRENCY=2
# TG_LISTENER_STATE_DIR="~/.cache/telegram-listener"

# ── Lark adapter ──
OP_LARK_APP_ID_REF="op://Vault/Lark/app_id"
OP_LARK_APP_SECRET_REF="op://Vault/Lark/app_secret"
# LARK_APP_ID / LARK_APP_SECRET  (raw values, if no secret manager)
# Comma-separated Lark open_ids with owner access
LARK_OWNER_OPEN_IDS="ou_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
LARK_DOMAIN="https://open.larksuite.com"
# LARK_CHAT_WHITELIST=""            # empty = all chats (owner-gated anyway)
# LARK_TASK_TIMEOUT_S=900
# LARK_LISTENER_STATE_DIR="~/.cache/lark-listener"

# ── Guest sandbox ──
# Path to the guest policy file (gitignored; see guest-policy.example.json)
# BRIDGE_GUEST_POLICY="/path/to/guest-policy.json"

# ── health-check.py ──
# Lark open_id to DM the daily health report to (via lark-cli --as bot)
BRIDGE_HEALTH_DM_OPEN_ID="ou_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# BRIDGE_LARK_CLI_PROFILE="lark-global"
# BRIDGE_LARK_UNIT="lark-listener.service"
